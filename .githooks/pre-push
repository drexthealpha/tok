#!/usr/bin/env bash
# Fast checks only, in parallel, on what changed: secret scan, lint, type
# check of the touched packages, tests related to the changed files.
# The full suite runs in CI.
set -uo pipefail
start=$(date +%s)
base=$(git rev-parse -q --verify "@{push}" 2>/dev/null || git rev-parse HEAD~1)
changed=$(git diff --name-only --diff-filter=ACMR "$base" HEAD)
code=$(echo "$changed" | grep -E '\.(ts|tsx|js|mjs)$' | grep -v '^android/' || true)
log=$(mktemp -d)

node scripts/secret-scan.mjs >"$log/secrets" 2>&1 &
pids="$!"
if [ -n "$code" ]; then
  npx eslint --cache --cache-location node_modules/.cache/eslint --max-warnings=0 $code >"$log/lint" 2>&1 &
  pids="$pids $!"
  mkdir -p node_modules/.cache
  for p in packages/core server web tests; do
    if echo "$code" | grep -q "^$p/"; then
      name=$(echo "$p" | tr '/' '-')
      npx tsc -p "$p" --incremental --tsBuildInfoFile "node_modules/.cache/tsc-$name.tsbuildinfo" >"$log/tsc-$name" 2>&1 &
      pids="$pids $!"
    fi
  done
  unit=$(echo "$code" | grep -E '^(packages|server|web)/' || true)
  if [ -n "$unit" ]; then
    # Chain tests need Linux (LiteSVM) and run in CI; here only unit tests.
    npx vitest related --run --passWithNoTests --maxWorkers=1 --exclude 'tests/**' $unit >"$log/tests" 2>&1 &
    pids="$pids $!"
  fi
fi

fail=0
for pid in $pids; do wait "$pid" || fail=1; done
if [ "$fail" -ne 0 ]; then
  for f in "$log"/*; do echo "== $(basename "$f")"; tail -20 "$f"; done
  echo "pre-push: failed"
  exit 1
fi
echo "pre-push: $(( $(date +%s) - start )) s"
