#!/usr/bin/env bash
# Fast checks only (under 60 s). The full suite runs in CI.
set -euo pipefail
start=$(date +%s)
changed=$(git diff --name-only --diff-filter=ACMR "@{push}" 2>/dev/null || git diff --name-only HEAD~1)
# Secret scan: exact partner keys (by hash) and key patterns.
node scripts/secret-scan.mjs
lintable=$(echo "$changed" | grep -E ".(ts|tsx|js|mjs)$" | grep -v "^android/" || true)
if [ -n "$lintable" ]; then npx eslint --max-warnings=0 $lintable; fi
for p in packages/core server web; do
  if echo "$changed" | grep -q "^$p/"; then [ -f "$p/tsconfig.json" ] && npx tsc -p "$p"; fi
done
npx vitest run --changed "@{push}" --passWithNoTests packages server web 2>/dev/null || npx vitest run --passWithNoTests packages
echo "pre-push: $(( $(date +%s) - start )) s"
